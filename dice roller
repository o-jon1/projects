import random
num = 6

def getTosses(num):
  rolls = [random.randint(1, 6) for i in range(num)]
  return rolls

def getLongestRun(list):
  maxRunLength = 0
  currentRunLength = 1
  longestRunStart = -1

  for i in range(1, len(list)):
      if list[i] == list[i - 1]:
          currentRunLength += 1
      else:
          if currentRunLength > maxRunLength:
              maxRunLength = currentRunLength
              longestRunStart = i - currentRunLength
          currentRunLength = 1
        
  if currentRunLength > maxRunLength:
      longestRunStart = len(list) - currentRunLength
  return longestRunStart

def getInput():
  savedNumber = int(input("Enter the number of rolls "))

  rolls = getTosses(savedNumber)
  print("Dice rolls:", rolls)

  longestRunStart = getLongestRun(rolls)

  if longestRunStart == -1:
      print("There are no runs sorry ¯\_(ツ)_/¯")
  else:
      print(f"The longest run starts at index {longestRunStart}")
getInput()
