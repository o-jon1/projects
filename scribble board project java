public class Board extends Field
{
	public void update(int r, int c)
	{
		super.update(r, c);
	}
	public void reset()
	{
		super.propagate();
	}
	public int getRow()
	{
		return frame.length;
	}
	public int getCol()
	{
		return frame[0].length;
	}
	public void loadWord(String word, int r, int c, boolean horizontal) 
	{
		if (horizontal) 
		{
			for (int i = 0; i < word.length(); i++) 
			{
				if (c + i < getCol() && r < getRow()) 
				{
					if (!inUse[r][c + i]) 
					{
						frame[r][c + i] = word.charAt(i);
						inUse[r][c + i] = true;
					}
				}
				else 
				{
					break;
				}
			}
		}
		else 
		{
			for (int i = 0; i < word.length(); i++) 
			{
				if (r + i < getRow() && c < getCol()) 
				{
					if (!inUse[r + i][c]) 
					{
						frame[r + i][c] = word.charAt(i);
						inUse[r + i][c] = true;
					}
				}
				else 
				{
					break;
				}
			}
		}
	}
	public void write(String word, int r, int c, boolean horizontal) 
	{
		if (horizontal) 
		{
			for (int i = 0; i < word.length(); i++) 
			{
				if (c + i < getCol() && r < getRow()) 
				{
					frame[r][c + i] = word.charAt(i);
					inUse[r][c + i] = true;
				}
				else 
				{
					break;
				}
			}
		}
		else 
		{
			for (int i = 0; i < word.length(); i++) 
			{
				if (r + i < getRow() && c < getCol()) 
				{
					frame[r + i][c] = word.charAt(i);
					inUse[r + i][c] = true;
				}
				else 
				{
					break;
				}
			}
		}
	}
	public void loadWord(String word, int r, int c, boolean horizontal, boolean reverse) 
	{
		if (!reverse) 
		{
			loadWord(word, r, c, horizontal);
		}
		else 
		{
			if (horizontal) 
			{
				for (int i = 0; i < word.length(); i++) 
				{
					if (c - i >= 0 && r < getRow()) 
					{
						if (!inUse[r][c - i]) 
						{
							frame[r][c - i] = word.charAt(i);
							inUse[r][c - i] = true;
						}
					}
					else 
					{
						break;
					}
				}
			}
			else 
			{
				for (int i = 0; i < word.length(); i++) 
				{
					if (r - i >= 0 && c < getCol()) 
					{
						if (!inUse[r - i][c]) 
						{
							frame[r - i][c] = word.charAt(i);
							inUse[r - i][c] = true;
						}
					}
					else 
					{
						break;
					}
				}
			}
		}
	}
	public void write(String word, int r, int c, boolean horizontal, boolean reverse) 
	{
		if (!reverse) 
		{
			write(word, r, c, horizontal);
		}
		else 
		{
			if (horizontal) 
			{
				for (int i = 0; i < word.length(); i++) 
				{
					if (c - i >= 0 && r < getRow()) 
					{
						frame[r][c - i] = word.charAt(i);
						inUse[r][c - i] = true;
					}
					else 
					{
						break;
					}
				}
			}
			else 
			{
				for (int i = 0; i < word.length(); i++) 
				{
					if (r - i >= 0 && c < getCol()) 
					{
						frame[r - i][c] = word.charAt(i);
						inUse[r - i][c] = true;
					}
					else 
					{
						break;
					}
				}
			}
		}
	}
}







public class Field
{
    protected char[][] frame;
    protected boolean[][] inUse;
    public Field()
    {
        frame = new char[1][8];
        inUse = new boolean[1][8];
        propagate();
    }
    
    protected void update(int r, int c)
    {
        frame = new char[r][c];
        inUse = new boolean[r][c];
        propagate();
    }
    
    protected void propagate()
    {
        for (int i = 0; i<frame.length;i++)
            for (int j = 0; j<frame[0].length;j++)
            {
                    frame[i][j]='*';
                    inUse[i][j]=false;
            }
    }
    
    public void print()
    {
        for (int i = 0; i<frame.length+2; i++)
        {
            for (int j = 0; j<frame[0].length+2; j++)
            {
                if (i==0||i==frame.length+1)
                    if (j==0||j==frame[0].length+1)
                        System.out.print('+');
                    else
                        System.out.print('-');
                else if (j==0||j==frame[0].length+1)
                    System.out.print('|');
                else
                    System.out.print(frame[i-1][j-1]);
            }
            System.out.println();
        }

    }
    
    public void loadWord (String pass)
    {
        for (int i = 0; i< Math.min(pass.length(),frame[0].length);i++)
            frame[0][i]=pass.charAt(i);
    }
}
