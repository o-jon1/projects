public class Checker 
{
    public static double palindrome(String input) {
        int matches = 0;
        String result = "";
        for (int e = 0; e < input.length(); e++) {
            char c = input.charAt(e);
            if (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z') {
                result += c;
            }
        }
        String clean = result.toLowerCase();
        for (int i = 0; i < clean.length() / 2; i++) {
            if (clean.charAt(i) == clean.charAt(clean.length() - 1 - i)) {
                matches++;
            }
        }
        int total = matches;
        return total / (double)(clean.length() / 2);
    }
    public static boolean anagram(String input1, String input2) {
        String sanitized1 = "";
        for (int e = 0; e < input1.length(); e++) {
            char c = input1.charAt(e);
            if (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z') {
                sanitized1 += c;
            }
        }
        sanitized1 = sanitized1.toLowerCase();
        String sanitized2 = "";
        for (int e = 0; e < input2.length(); e++) {
            char c = input2.charAt(e);
            if (c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z') {
                sanitized2 += c;
            }
        }
        sanitized2 = sanitized2.toLowerCase();
        if (sanitized1.length() != sanitized2.length()) {
            return false;
        }
        int[] occurrences1 = new int[26];
        for (int i = 0; i < sanitized1.length(); i++) {
            char c = sanitized1.charAt(i);
            occurrences1[c - 'a']++;
        }
        int[] occurrences2 = new int[26];
        for (int i = 0; i < sanitized2.length(); i++) {
            char c = sanitized2.charAt(i);
            occurrences2[c - 'a']++;
        }
        for (int i = 0; i < 26; i++) {
            if (occurrences1[i] != occurrences2[i]) {
                return false;
            }
        }
        return true;
    }
}
