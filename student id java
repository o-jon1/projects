public class studentID {
    private char firstN;
    private char lastN;
    private boolean isMale;
    private int grade;
    private long ID;
    private String genderStr;
    private String gradeStr;
    private String encoded = "";

    public studentID(long ID) {
        this.ID = ID;
        decode();
    }
    public studentID(char firstN, char lastN, boolean isMale, int grade) {
        this.firstN = firstN;
        this.lastN = lastN;
        this.isMale = isMale;
        this.grade = grade;
        this.ID = Long.parseLong(encode());
    }
    public String encode() {
        encoded = "";
        if (grade == 0) {
            encoded += "00";
        }
        else if (grade == 1) {
            encoded += "01";
        }
        else if (grade == 2) {
            encoded += "10";
        }
        else if (grade == 3) {
            encoded += "11";
        }
        int firstNV = firstN - 'A' + 1;
        int lastNV = lastN - 'A' + 1;
        String firstNBits = Integer.toBinaryString(firstNV);
        String lastNBits = Integer.toBinaryString(lastNV);
        while (firstNBits.length() < 5) {
            firstNBits = "0" + firstNBits;
        }
        while (lastNBits.length() < 5) {
            lastNBits = "0" + lastNBits;
        }
        encoded += firstNBits;
        encoded += lastNBits;
        if (isMale) {
            encoded += "0";
        }
        else {
            encoded += "1";
        }
        return encoded;
    }
    public void decode() {
        if ((ID / 100000000000L) == 0) {
            grade = 0;
        }
        else if ((ID / 100000000000L) == 1) {
            grade = 1;
        }
        else if ((ID / 100000000000L) == 10) {
            grade = 2;
        }
        else if ((ID / 100000000000L) == 11) {
            grade = 3;
        }
        long firstNV = (ID / 1000000) % 100000;
        long lastNV = (ID / 10) % 100000;
        firstN = (char)('A' + firstNV - 1);
        lastN = (char)('A' + lastNV - 1);
        if ((ID % 10) == 0) {
            isMale = true;
        }
        else {
            isMale = false;
        }
    }
    public char getFirstN() {
        return firstN;
    }
    public char getLastN() {
        return lastN;
    }
    public boolean getIsMale() {
        return isMale;
    }
    public int getGrade() {
        return grade;
    }
    public long getID() {
        return ID;
    }
    public void print() {
        if (isMale) {
            genderStr = "Male";
        }
        else {
            genderStr = "Female";
        }
        if (grade == 0) {
            gradeStr = "Freshman";
        }
        else if (grade == 1) {
            gradeStr = "Sophomore";
        }
        else if (grade == 2) {
            gradeStr = "Junior";
        }
        else if (grade == 3) {
            gradeStr = "Senior";
        }
        else {
            System.out.println("Pick a number between 0-3 for grade\n");
        }
        System.out.println("First Initial: " + firstN);
        System.out.println("Last Initial:  " + lastN);
        System.out.println("Gender:        " + genderStr);
        System.out.println("Grade:         " + gradeStr);
        System.out.println("Student ID:    " + ID + "\n\n");
    }
}







public class Main{
	public static void main(String[] args) {
		studentID stu1 = new studentID('J', 'S', true, 2);
		System.out.println("Original\n");
		stu1.print();
		long finalID = stu1.getID();
		studentID stu2 = new studentID(finalID);
		System.out.println("Translated\n");
		stu2.print();
	}
}
